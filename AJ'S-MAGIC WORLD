const KEY="ajs_magic_world_v1";
const seed=[
{id:"seed1",name:"Starter Business Toolkit",category:"Digital",price:149,description:"A practical digital starter pack for planning your next small-business idea.",seller:"AJ's Studio",icon:"✦"},
{id:"seed2",name:"Social Media Template Pack",category:"Templates",price:89,description:"Reusable content layouts to help a small business look polished online.",seller:"Creative Corner",icon:"▧"},
{id:"seed3",name:"Construction Quote Template",category:"Construction",price:65,description:"A clean editable quote layout for labour, materials and project totals.",seller:"BuildSmart",icon:"⌂"},
{id:"seed4",name:"Small Business Setup Session",category:"Services",price:250,description:"A demo listing for a planning and setup consultation service.",seller:"Launch Desk",icon:"↗"}
];
let data=loadData(), cart=loadCart(), activeCategory="All", toastTimer;
function loadData(){try{const d=JSON.parse(localStorage.getItem(KEY));return Array.isArray(d)&&d.length?d:seed.slice()}catch{return seed.slice()}}
function saveData(){localStorage.setItem(KEY,JSON.stringify(data))}
function loadCart(){try{return JSON.parse(localStorage.getItem(KEY+"_cart"))||[]}catch{return []}}
function saveCart(){localStorage.setItem(KEY+"_cart",JSON.stringify(cart))}
const money=n=>"R"+Number(n||0).toLocaleString("en-ZA",{minimumFractionDigits:2,maximumFractionDigits:2});
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function toast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove("show"),2400)}
function showView(view){document.querySelectorAll("main .section").forEach(s=>s.classList.add("hidden"));if(view==="market"){document.getElementById("marketplace").classList.remove("hidden")}else{document.getElementById(view).classList.remove("hidden")}document.querySelectorAll(".nav").forEach(b=>b.classList.toggle("active",b.dataset.view===view));if(view==="seller")renderSeller();if(view==="admin")renderAdmin();window.scrollTo({top:view==="market"?350:0,behavior:"smooth"})}
function renderProducts(){const q=document.getElementById("searchInput").value.toLowerCase().trim();const list=data.filter(p=>(activeCategory==="All"||p.category===activeCategory)&&[p.name,p.description,p.seller,p.category].join(" ").toLowerCase().includes(q));document.getElementById("productGrid").innerHTML=list.map(p=>`<article class="product-card"><div class="product-art"><span>${esc(p.icon||"✦")}</span></div><div class="product-info"><span class="category">${esc(p.category)}</span><h3>${esc(p.name)}</h3><p>${esc(p.description)}</p><div class="product-bottom"><span class="price">${money(p.price)}</span><button class="add-button" data-add="${esc(p.id)}">+ Add to cart</button></div><small class="fine">by ${esc(p.seller||"Independent seller")}</small></div></article>`).join("");document.getElementById("emptyState").classList.toggle("hidden",list.length>0)}
function renderCart(){document.getElementById("cartCount").textContent=cart.reduce((n,x)=>n+x.qty,0);const items=cart.map(x=>({...x,product:data.find(p=>p.id===x.id)})).filter(x=>x.product);document.getElementById("cartItems").innerHTML=items.length?items.map(x=>`<div class="cart-row"><div><strong>${esc(x.product.name)}</strong><small>${x.qty} × ${money(x.product.price)}</small></div><div><strong>${money(x.qty*x.product.price)}</strong><br><button data-remove="${esc(x.id)}">Remove</button></div></div>`).join(""):'<p class="muted">Your cart is empty. Add something from the marketplace.</p>';const total=items.reduce((s,x)=>s+x.qty*x.product.price,0);document.getElementById("cartTotal").textContent=money(total);renderAdminStats(total)}
function renderSeller(){const own=data.filter(p=>p.owner==="user");document.getElementById("sellerListingCount").textContent=own.length;document.getElementById("sellerListings").innerHTML=own.length?own.map(p=>`<div class="seller-row"><div><strong>${esc(p.name)}</strong><small>${esc(p.category)} · ${money(p.price)}</small></div><button data-delete="${esc(p.id)}">Delete</button></div>`).join(""):'<p class="muted">You have not created a listing yet. Add your first one using the form.</p>'}
function renderAdminStats(total){document.getElementById("adminListings").textContent=data.length;document.getElementById("adminCart").textContent=cart.reduce((n,x)=>n+x.qty,0);document.getElementById("adminValue").textContent=money(total);document.getElementById("adminFee").textContent=money(total*.1)}
function renderAdmin(){renderAdminStats(cart.reduce((s,x)=>{const p=data.find(p=>p.id===x.id);return s+(p?p.price*x.qty:0)},0));document.getElementById("adminListingsList").innerHTML=data.map(p=>`<div class="seller-row"><div><strong>${esc(p.name)}</strong><small>${esc(p.seller||"Seller")} · ${esc(p.category)} · ${money(p.price)}</small></div><small>${p.owner==="user"?"Your listing":"Demo listing"}</small></div>`).join("")}
document.addEventListener("click",e=>{const v=e.target.closest("[data-view]");if(v)showView(v.dataset.view);const jump=e.target.closest("[data-jump]");if(jump){showView("market");document.getElementById("marketplace").scrollIntoView({behavior:"smooth"})}const add=e.target.closest("[data-add]");if(add){const id=add.dataset.add,found=cart.find(x=>x.id===id);if(found)found.qty++;else cart.push({id,qty:1});saveCart();renderCart();toast("Added to your demo cart")}const rem=e.target.closest("[data-remove]");if(rem){cart=cart.filter(x=>x.id!==rem.dataset.remove);saveCart();renderCart()}const del=e.target.closest("[data-delete]");if(del){data=data.filter(x=>x.id!==del.dataset.delete);saveData();renderSeller();renderProducts();renderAdmin();toast("Listing deleted")}const filter=e.target.closest("[data-category]");if(filter){activeCategory=filter.dataset.category;document.querySelectorAll(".filter").forEach(b=>b.classList.toggle("active",b===filter));renderProducts()}});
document.getElementById("searchInput").addEventListener("input",renderProducts);
document.getElementById("listingForm").addEventListener("submit",e=>{e.preventDefault();const f=new FormData(e.target);const name=String(f.get("name")).trim(),description=String(f.get("description")).trim(),price=Number(f.get("price"));if(!name||!description||!Number.isFinite(price)||price<=0){toast("Please complete all required fields");return}data.unshift({id:"user_"+Date.now(),name,category:String(f.get("category")),price,description,seller:String(f.get("seller")||"My Shop").trim(),icon:{"Digital":"✦","Services":"↗","Templates":"▧","Construction":"⌂"}[String(f.get("category"))],owner:"user"});saveData();e.target.reset();renderProducts();renderSeller();renderAdmin();toast("Demo listing published in this browser")});
document.getElementById("cartButton").addEventListener("click",()=>document.getElementById("cartDrawer").classList.remove("hidden"));
document.getElementById("closeCart").addEventListener("click",()=>document.getElementById("cartDrawer").classList.add("hidden"));
document.getElementById("checkoutButton").addEventListener("click",()=>{if(!cart.length){toast("Your cart is empty");return}toast("Demo checkout only — no payment was taken")});
document.getElementById("exportButton").addEventListener("click",()=>{const rows=[["Name","Category","Price ZAR","Seller","Description"],...data.map(p=>[p.name,p.category,p.price,p.seller,p.description])];const csv=rows.map(r=>r.map(v=>'"'+String(v??"").replace(/"/g,'""')+'"').join(",")).join("\r\n");const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"}));a.download="ajs-magic-world-listings.csv";a.click();URL.revokeObjectURL(a.href);toast("Listings CSV exported")});
renderProducts();renderCart();renderSeller();
